# CORS: the exact origin your frontend runs on
FRONTEND_URL=http://localhost:5173

# Secret used to sign/verify auth JWT cookies — use a long random string
JWT_SECRET=

# MongoDB connection string (local or Atlas)
MONGODB_URL=

# ImageKit (video/image storage for reels and profile pictures)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Base URL of a JioSaavn-compatible song search API
SAAVN_API_BASE_URL=

# Brevo transactional email API — used for OTP, welcome, and order-bill emails.
# MAIL_USER must be verified as a "sender" in your Brevo dashboard (Senders & IP > Senders).
MAIL_USER=
BREVO_API_KEY=
